# RachBase site-controller — local dev config (.env is gitignored)

# Which component this process runs (production: one profile per Deployment).
# Leave unset for the dev CLI (health / provision-demo).
# SITE_CONTROLLER_PROFILE=api        # api | tenant | workload | build

# Local dev: talk to the ARKA test cluster via the DECRYPTED kubeconfig.
#   gpg --decrypt arka-kubeconfig.gpg > /path/to/arka.kubeconfig && chmod 600 ...
ARKA_KUBECONFIG=/absolute/path/to/arka.kubeconfig
# ARKA_KUBECONFIG_B64=              # or inline: base64 -w0 /path/to/arka.kubeconfig

# --- BFF-side site API config (handed over by SpaceArk; used by the BFF, NOT here) ---
# SITE_ID=site1
# SITE_API_URL removed — the BFF resolves each sites URL from its `sites` table (migration 108), not env.
# OAUTH_ISSUER=...
# OAUTH_AUDIENCE=spaceark-site-api:site1
# OAUTH_CLIENT_ID=...
# OAuth private key + mTLS client cert/key + CA live in the BFF's secret store.

# --- Public routing (self-managed per-app Ingress) — workload profile ---
# Turn on per-app Ingress creation. When off, the controller only creates the in-cluster
# Service and the edge/BFF is responsible for publishing routes.
SITE_SELF_INGRESS=1
# Base domain for platform app hosts (host normally arrives from the BFF via the
# `rachbase.io/host` annotation; this is only a fallback/label default).
APPS_DOMAIN=rachbase.app
# Ingress controller your cluster runs (defaults match k3s Traefik). Override to match yours.
SITE_INGRESS_NAMESPACE=kube-system
SITE_INGRESS_CLASS=traefik
SITE_INGRESS_POD_LABEL_KEY=app.kubernetes.io/name
SITE_INGRESS_POD_LABEL_VAL=traefik
# Traefik ACME resolver name for Let's Encrypt TLS. Set only after the cluster's Traefik
# has a resolver by this name (see DEPLOY.md §7). Empty = no TLS annotations emitted.
SITE_INGRESS_CERTRESOLVER=le
# Public resolvers the controller checks before creating the Ingress, so it only publishes
# once DNS has propagated globally (avoids Let's Encrypt NXDOMAIN negative-caching).
SITE_DNS_CHECK_RESOLVERS=8.8.8.8,1.1.1.1
# Set to 1 ONLY if ARKA's installed App CRD declares spec.host. Otherwise leave unset —
# the host rides as a CR annotation (schema-safe across CRD versions).
# SITE_APP_SPEC_HOST=1

# --- Build profile ---
# Off by default. Enable once ARKA's source→image build/ingest service is wired.
# SITE_BUILDS_ENABLED=true
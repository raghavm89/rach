# ── rachbase-backend (Cloud / BaaS API) ──────────────────────────────
PORT=8080
NODE_ENV=production
# Reverse-proxy hop count (Railway/nginx = 1). REQUIRED in prod behind a proxy: without it
# every IP-keyed rate limit shares the proxy's IP (one signup bucket for the whole platform,
# per-email login lockout DoS) and geo/tax IP lookups see the proxy. Unset = direct traffic.
# Setting this when there is NO proxy lets clients spoof their IP via X-Forwarded-For.
TRUST_PROXY=1
CORS_ORIGINS=https://app.rachbase.example,https://rachdev.example

# PostgreSQL (RachBase owns the system-of-record DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rach_db
DB_USER=postgres
DB_PASSWORD=change_me

# JWT — RachBase is the identity provider (issues the tokens both apps trust)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# Billing (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me
USD_TO_INR=90

# OAuth
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me

# GitHub App (deploy engine)
GITHUB_APP_ID=change_me
GITHUB_APP_PRIVATE_KEY=change_me

# Deploy SSH key (one of)
# DEPLOY_SSH_KEY_PATH=/run/secrets/rach_deploy_key
# DEPLOY_SSH_PRIVATE_KEY=

# Monitoring
PROMETHEUS_URL=http://prometheus:9090

# Notifications
BREVO_API_KEY=change_me
BREVO_FROM_EMAIL=noreply@rachbase.example
BREVO_FROM_NAME=RachBase
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# GoDaddy DNS — auto domains <name>.rachbase.com (production key on the rachbase.com account)
GODADDY_API_KEY=replace_with_godaddy_production_key
GODADDY_API_SECRET=replace_with_godaddy_production_secret
RACHBASE_DOMAIN=rachbase.com

# Service-to-service auth — shared secret RachDev uses to call /internal/*
RACHBASE_SERVICE_TOKEN=change_me_shared_secret

APP_URL=https://app.rachbase.example
BACKEND_URL=https://api.rachbase.example
FEATURE_PRO_TIER=true
# SITE_API_URL removed — site base URLs now live in the `sites` table (migration 108).
# Seed a row with siteRegistry.upsertSite({ siteId, apiUrl }); a tenant.site_id selects it.
# The shared partner identity stays here: MTLS_CERT(_FILE), MTLS_KEY(_FILE), MTLS_CA(_FILE), OAUTH_PRIVATE_KEY(_FILE).
MTLS_CERT_FILE=/secrets/client.crt
MTLS_KEY_FILE=/secrets/client.key
OAUTH_PRIVATE_KEY_FILE=/secrets/oauth.key
MTLS_CA_FILE=/secrets/ca.crt
OAUTH_CLIENT_ID=rachbase-bff
SITE_ALLOW_INSECURE_HTTP=1
# ── BaaS backups (logical pg_dump → S3-compatible object storage) ──────────────────────────────
# Backups go to ARKA's S3-compatible store (endpoint + creds provided by ARKA). The client speaks
# generic S3 SigV4 (path-style), so MinIO/Ceph/AWS all work. Requires postgresql-client (pg_dump,
# pg_restore, createdb) on PATH where this backend runs. Until BACKUP_S3_* is set, the daily
# backup worker no-ops and the dashboard Backups tab shows "not configured".
BACKUP_S3_ENDPOINT=            # e.g. https://s3.arka.internal  (ARKA-provided)
BACKUP_S3_BUCKET=              # e.g. rachbase-baas-backups
BACKUP_S3_REGION=us-east-1     # region label the store expects (MinIO/Ceph often 'us-east-1')
BACKUP_S3_ACCESS_KEY=          # ARKA-provided
BACKUP_S3_SECRET_KEY=          # ARKA-provided (keep in the secret store, not source control)
BACKUP_S3_PREFIX=backups       # key prefix within the bucket
# BACKUP_TICK_MS=3600000       # optional: worker check interval (default 1h; backs up once/day/project)

# Admin connection to the managed BaaS Postgres cluster (pg_dump targets each project's baas_<ref>).
BAAS_PG_ADMIN_URL=            # postgresql://admin:pw@host:5432/postgres  (ARKA-provided)

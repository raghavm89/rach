# ── rachbase-backend (Cloud / BaaS API) ──────────────────────────────
PORT=8080
NODE_ENV=production
# TRUST_PROXY=1
CORS_ORIGINS=https://app.rachbase.example,https://rachdev.example

# PostgreSQL (RachBase owns the system-of-record DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rach_db
DB_USER=postgres
DB_PASSWORD=change_me

# JWT — RachBase is the identity provider (issues the tokens both apps trust)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# Billing (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me
USD_TO_INR=90

# OAuth
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me

# GitHub App (deploy engine)
GITHUB_APP_ID=change_me
GITHUB_APP_PRIVATE_KEY=change_me

# Deploy SSH key (one of)
# DEPLOY_SSH_KEY_PATH=/run/secrets/rach_deploy_key
# DEPLOY_SSH_PRIVATE_KEY=

# Monitoring
PROMETHEUS_URL=http://prometheus:9090

# Notifications
BREVO_API_KEY=change_me
BREVO_FROM_EMAIL=noreply@rachbase.example
BREVO_FROM_NAME=RachBase
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# GoDaddy DNS — auto domains <name>.rachbase.com (production key on the rachbase.com account)
GODADDY_API_KEY=replace_with_godaddy_production_key
GODADDY_API_SECRET=replace_with_godaddy_production_secret
RACHBASE_DOMAIN=rachbase.com

# Service-to-service auth — shared secret RachDev uses to call /internal/*
RACHBASE_SERVICE_TOKEN=change_me_shared_secret

APP_URL=https://app.rachbase.example
BACKEND_URL=https://api.rachbase.example
RACHBASE_SERVICE_TOKEN=chan

# ── rachdev-backend (AI Agent Builder API) ───────────────────────────
PORT=8081
NODE_ENV=production
CORS_ORIGINS=https://rachdev.example
LLM_MOCK=1

# PostgreSQL (shared RachBase DB through launch; see roadmap for later split)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rach_db
DB_USER=postgres
DB_PASSWORD=change_me

# JWT — MUST match RachBase's secrets so RachDev validates RachBase-issued tokens
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# Billing (agent credit purchase)
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me
USD_TO_INR=90

# Self-serve signup. ON by default for the product-led (credits) motion: anyone
# can sign up, gets a personal workspace + free credits, and builds/tests before
# paying. Set to false for the admin-provisioned ("Google Workspace") model.
PUBLIC_SIGNUP_ENABLED=true

# Free credits granted to a new workspace on signup (0 = no grant / admin model).
# When > 0, every signup auto-provisions a personal workspace to hold them.
# 1 credit ≈ 1000 tokens, so a test run costs a few credits — bump this if you
# want new users to get more free runs.
SIGNUP_FREE_CREDITS=5

# OAuth (RachDev mounts auth for a self-contained dev app)
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me

# LLM gateway
ANTHROPIC_API_KEY=change_me

# Notifications
BREVO_API_KEY=change_me
BREVO_FROM_EMAIL=noreply@rachdev.example
BREVO_FROM_NAME=RachDev

# ── Connectors (agent tools + channels) ──────────────────────────────
# Secret store: AES-256 key that encrypts every tenant's connector credentials
# at rest (Razorpay/Stripe/Slack/Shopify/WhatsApp tokens). MUST be a stable
# secret of 16+ chars — rotating it makes existing stored credentials unreadable.
INTEGRATIONS_ENCRYPTION_KEY=change_me_32_char_min_secret

# Public base URL of THIS backend. Used to build the website-widget embed src,
# the WhatsApp webhook URL, and the OAuth redirect_uri. Must be reachable by
# browsers/providers and (for OAuth) match what's registered with each app.
PUBLIC_API_BASE=https://api.rachdev.example

# Dashboard base URL — where the OAuth callback sends the user back after
# authorizing (…/dashboard/connections?connected=…). Also the allowed
# post-callback redirect target (open-redirect guard uses this + CORS_ORIGINS).
DASHBOARD_URL=https://rachdev.example

# Connector OAuth apps. A provider is only offered when both id + secret are set.
SLACK_CLIENT_ID=change_me
SLACK_CLIENT_SECRET=change_me
SLACK_SCOPES=chat:write,channels:read
SHOPIFY_CLIENT_ID=change_me
SHOPIFY_CLIENT_SECRET=change_me
SHOPIFY_SCOPES=read_orders,read_fulfillments

# Dev/CI switches: skip the real provider round-trips (store fake tokens / capture
# outbound sends) so the OAuth and WhatsApp loops are testable without live apps.
# Leave unset (or 0) in production.
OAUTH_MOCK=0
WHATSAPP_MOCK=0

# RachBase internal API — where RachDev sends deploy/run-command requests
RACHBASE_API_URL=https://api.rachbase.example
RACHBASE_SERVICE_TOKEN=chan

APP_URL=https://rachdev.example

SIGNUP_FREE_CREDITS=5

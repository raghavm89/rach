# ── rachdev-backend (AI Agent Builder API) ───────────────────────────
PORT=8081
NODE_ENV=production
CORS_ORIGINS=https://rachdev.example

# PostgreSQL (shared RachBase DB through launch; see roadmap for later split)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rach_db
DB_USER=postgres
DB_PASSWORD=change_me

# JWT — MUST match RachBase's secrets so RachDev validates RachBase-issued tokens
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# Billing (agent credit purchase)
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me
USD_TO_INR=90

# OAuth (RachDev mounts auth for a self-contained dev app)
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me

# LLM gateway
ANTHROPIC_API_KEY=change_me

# Notifications
BREVO_API_KEY=change_me
BREVO_FROM_EMAIL=noreply@rachdev.example
BREVO_FROM_NAME=RachDev

# RachBase internal API — where RachDev sends deploy/run-command requests
RACHBASE_API_URL=https://api.rachbase.example
RACHBASE_SERVICE_TOKEN=change_me_shared_secret

APP_URL=https://rachdev.example
